# 아래 값들을 실제 정보로 채운 후 파일명을 .env 로 변경하세요

# Gmail 계정 (발송용)
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx   # Gmail 앱 비밀번호 (띄어쓰기 포함 16자리)

# 회사명 (이메일 발신자명 및 이메일 본문에 사용)
COMPANY_NAME=쌍곰

# 배포 후 실제 서버 주소로 변경 (다운로드 링크에 사용)
SERVER_BASE_URL=https://your-app.onrender.com

# Supabase Storage (다운로드 ZIP 보관 — 서버 재시작과 무관하게 24h 유지)
# 공개키(anon) 방식이라 코드에 기본값이 내장되어 별도 설정 없이 동작함.
# 다른 프로젝트로 바꾸려면 아래 값을 덮어쓰면 됨.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=eyJhbGci...   # anon 공개키
# SUPABASE_BUCKET=ssangkom-zips

# (선택) 업로드 스팸 완전 차단용 service_role 비밀키.
# 설정 시 업로드가 이 키로 동작 → anon INSERT 정책 제거 가능. 절대 커밋 금지.
# SUPABASE_SERVICE_KEY=eyJhbGci...

# (선택) /admin/* 보호 토큰 (미설정 시 admin 엔드포인트·발송기록 조회 비활성)
# 발송기록 조회: https://...onrender.com/admin/logs?token=이값
# ADMIN_TOKEN=원하는_긴_랜덤_문자열

# (선택) 발송 실패/부분발송 경고를 받을 이메일 (미설정 시 GMAIL_USER로)
# ADMIN_EMAIL=alert@company.com

# (선택) 발송 레이트리밋 (기본 분5/시간30)
# RATE_PER_MIN=5
# RATE_PER_HOUR=30
